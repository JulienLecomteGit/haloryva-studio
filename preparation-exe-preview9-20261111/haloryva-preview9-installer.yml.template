# PREPARED ONLY. This file is intentionally outside .github/workflows.
# Activate only following an explicit request to build the installer.
name: Haloryva preview.9 installer-only build and extraction
on:
  push:
    branches: ['haloryva-preparation-exe-preview9']
    paths: ['.github/workflows/haloryva-preview9-installer.yml']
permissions:
  contents: read
  actions: read
jobs:
  package-only:
    runs-on: windows-2025
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: Haloryva-2.7.1-preview.9-build
          run-id: 43035196363
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: ${{ runner.temp }}/haloryva-preview9-frozen/
      - name: Compile setup around the frozen application and check extraction only
        shell: powershell
        run: ./preparation-exe-preview9-20261111/Build-InstallerOnly.prepared.ps1 -BuildAndCheckExtraction
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: HaloryvaSetup-2.7.1-preview.9-candidate
          path: ${{ runner.temp }}/haloryva-preview9-installer/
          retention-days: 30
